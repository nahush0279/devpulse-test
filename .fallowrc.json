{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",

    "circular-dependencies": "warn"
  },
  "ignoreExports": [
    "lib/fallow-fixtures/duplicates/shipping-a.ts",
    "lib/fallow-fixtures/duplicates/shipping-b.ts",
    "lib/fallow-fixtures/duplicates/discount-a.ts",
    "lib/fallow-fixtures/duplicates/discount-b.ts"
  ]
}
